{
  "version": 4,
  "configurations": [
    {
      "name": "Win32",
      "intelliSenseMode": "windows-msvc-x64",
      "cStandard": "c17",
      "cppStandard": "c++17",
      "compilerPath": "cl.exe",
      "compileCommands": "${workspaceFolder}/build/msvc/compile_commands.json",
      "includePath": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/../SFML-2.6.2-windows-vc17-64-bit/include",
        "${workspaceFolder}/build/msvc/**"
      ],
      "defines": [
        "_WIN32",
        "WIN32",
        "_WINDOWS",
        "UNICODE",
        "_UNICODE"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/src",
          "${workspaceFolder}/../SFML-2.6.2-windows-vc17-64-bit/include"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}
